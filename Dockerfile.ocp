FROM docker.io/library/node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build:docker

FROM docker.io/library/node:22-alpine
WORKDIR /app
COPY runtime/package*.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY --from=build /app/dist ./public
COPY server.js ./
EXPOSE 8080
USER 1001
CMD ["node", "server.js"]
